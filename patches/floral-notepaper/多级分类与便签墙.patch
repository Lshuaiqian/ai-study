+/// `create_note` / `update_note` / `move_note_to_category` 用它。
+/// 改前这几个入口直接 `request.category.clone()`，`category = "../x"` 会把文件写到
+/// notesDir 之外——这是补丁顺手堵上的一个真实漏洞。
+pub(crate) fn normalize_optional_category(name: &str) -> Result<String, AppError> {
+    if name.trim().is_empty() {
+        Ok(String::new())
+    } else {
+        normalize_category(name)
+    }
+}
