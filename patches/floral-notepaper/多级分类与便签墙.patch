+//! 学习助手：把学习体系（`study/`）的「一键整理」流水线接进花笺。
+//!
+//! 这个模块是**触发器 + 显示器**，整理的大脑始终是 `study/tools/tidy.py` ——
+//! 不在这里重写任何整理逻辑（方案 §1 非目标）。
+//!
+//! ## 安全边界（方案 §5.4）
+//! `study_tidy_start` 本质上会执行一个**用户可配置路径下的可执行文件**，也就是
+//! 一个任意命令执行入口。因此：
+//!   - 只接受 `note_path` 与 `apply` 两个参数，**绝不接受任意命令行**；
+//!   - `python` 与脚本路径全部由配置拼装，前端无法传入；
+//!   - `note_path` 必须落在花笺自己的 notesDir 内（canonicalize 后前缀校验，防 `..` 穿越），
+//!     且必须是 `.md`。
+//!
+//! ## 生命周期（方案 §5.3）
+//!   - 子进程 stdout 逐行读 → 每行 `app.emit(EVENT_NAME, line)`（行本身就是 tidy.py
+//!     `--json` 产出的一条 JSONL，前端 `JSON.parse` 即可）；
+//!   - 同一个 `note_path` 同时只允许一个 run：重复点按钮**复用已有 run_id**，
+//!     不重复烧钱调模型；
+//!   - 超时/取消都在**监督线程**里 kill 并 `wait()` 回收，不留孤儿 python；
+//!   - Windows 下 `CREATE_NO_WINDOW`，不闪黑框。
+
+use crate::services::notes::{default_store, AppConfig, AppError};
+use serde::Serialize;
+use std::collections::HashMap;
+use std::io::{BufRead, BufReader, Read};
+use std::path::{Path, PathBuf};
+use std::process::{Child, Command, Stdio};
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::sync::{Arc, Mutex, OnceLock};
+use std::thread;
+use std::time::{Duration, Instant};
+use tauri::{AppHandle, Emitter};
+
+/// 流式事件名；前端 `listen("study://tidy/event")`。
+pub const EVENT_NAME: &str = "study://tidy/event";
+
+/// 监督线程轮询子进程的间隔。
+const POLL_INTERVAL: Duration = Duration::from_millis(120);
+/// `study_ping` 的探测超时。
+const PING_TIMEOUT: Duration = Duration::from_secs(20);
+/// 失败时随 exit 事件回传的 stderr 尾部上限（诊断够用，又不至于把事件撑爆）。
+const STDERR_TAIL_LIMIT: usize = 8 * 1024;
+/// 超时下限：模型要跑两次，30–90 秒是常态。
+const MIN_TIMEOUT_S: u64 = 10;
+/// Windows `CREATE_NO_WINDOW`。
+#[cfg(windows)]
+const CREATE_NO_WINDOW: u32 = 0x0800_0000;
+
+#[derive(Debug, Clone, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct StudyPing {
+    pub ok: bool,
+    pub python_version: Option<String>,
+    pub python: String,
+    pub study_root: String,
+    pub script: String,
+    pub script_exists: bool,
+    pub error: Option<String>,
+}
+
+#[derive(Debug, Clone, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct StudyRunStart {
+    pub run_id: String,
+    /// `true` = 这篇笔记已有一个在跑，复用了它的 run_id（防狂点）。
+    pub reused: bool,
+}
+
+struct RunHandle {
+    run_id: String,
+    /// 取消标志：监督线程轮询到它就把子进程 kill 掉并回收。
+    /// 这里**不存 Child 句柄** —— 句柄由监督线程独占持有，两处持有只会多一层锁、
+    /// 并让「谁负责 wait 回收」变得含糊。
+    cancel: Arc<AtomicBool>,
+}
+
+fn registry() -> &'static Mutex<HashMap<String, RunHandle>> {
+    static REGISTRY: OnceLock<Mutex<HashMap<String, RunHandle>>> = OnceLock::new();
+    REGISTRY.get_or_init(|| Mutex::new(HashMap::new()))
+}
+
+fn app_error(code: &str, message: impl Into<String>) -> AppError {
+    AppError {
+        code: code.to_string(),
+        message: message.into(),
+        details: Default::default(),
+    }
+}
+
+/// 整理脚本路径：`<study_root>/study/tools/tidy.py`。
+fn tidy_script(study_root: &str) -> PathBuf {
+    PathBuf::from(study_root)
+        .join("study")
+        .join("tools")
+        .join("tidy.py")
+}
+
+/// 纯函数：`candidate` 必须落在 `notes_root` 内，且是 `.md`。
+///
+/// 两侧都必须是**已 canonicalize** 的绝对路径（调用方负责），否则 `..` 穿越
+/// 会在比较时被绕过——`\\?\` 前缀（Windows canonicalize 的产物）两边一致，
+/// 不影响 `starts_with`。
+fn validate_within(notes_root: &Path, candidate: &Path) -> Result<PathBuf, AppError> {
+    if !candidate.starts_with(notes_root) {
+        return Err(app_error(
+            "unsafePath",
+            "只能整理花笺笔记目录里的文件（已拒绝目录外的路径）",
+        ));
+    }
+    let is_md = candidate
+        .extension()
+        .and_then(|s| s.to_str())
+        .map(|s| s.eq_ignore_ascii_case("md"))
+        .unwrap_or(false);
+    if !is_md {
+        return Err(app_error("notMarkdown", "只能整理 Markdown 笔记（.md）"));
+    }
+    Ok(candidate.to_path_buf())
+}
+
+/// 把前端传来的 `note_path` 解析成可信的绝对路径。
+fn resolve_note_path(note_path: &str) -> Result<PathBuf, AppError> {
+    let store = default_store()?;
+    let notes_dir = store.data_dir().join("notes");
+    let root = notes_dir.canonicalize().map_err(|e| {
+        app_error(
+            "notesDirUnavailable",
+            format!("花笺笔记目录不可用：{} ({e})", notes_dir.display()),
+        )
+    })?;
+    let real = Path::new(note_path).canonicalize().map_err(|e| {
+        app_error("noteNotFound", format!("找不到笔记文件：{note_path} ({e})"))
+    })?;
+    validate_within(&root, &real)
+}
+
+/// 组装命令行：**参数只有 note_path 与固定的几个 flag**，没有任意透传。
+fn build_command(
+    cfg: &AppConfig,
+    note_path: &Path,
+    extra: &[String],
+) -> Result<Command, AppError> {
+    let script = tidy_script(&cfg.study_root);
+    if !script.is_file() {
+        return Err(app_error(
+            "scriptMissing",
+            format!("找不到整理脚本：{}", script.display()),
+        ));
+    }
+    if !Path::new(&cfg.study_python).is_file() {
+        return Err(app_error(
+            "pythonMissing",
+            format!("找不到 Python：{}", cfg.study_python),
+        ));
+    }
+    let mut cmd = Command::new(&cfg.study_python);
+    cmd.arg(&script).arg("--path").arg(note_path);
+    for arg in extra {
+        cmd.arg(arg);
+    }
+    cmd.arg("--json");
+    // 工作目录固定为 study 根：脚本内部虽会自插 BASE，固定 cwd 让相对输出可预期
+    cmd.current_dir(&cfg.study_root);
+    cmd.stdout(Stdio::piped()).stderr(Stdio::piped());
+    #[cfg(windows)]
+    {
+        use std::os::windows::process::CommandExt;
+        cmd.creation_flags(CREATE_NO_WINDOW);
+    }
+    Ok(cmd)
+}
+
+/// 起一个 run：登记互斥 → 逐行流式 emit → 监督线程收尾。
+fn spawn_run(
+    app: AppHandle,
+    cfg: AppConfig,
+    real_path: PathBuf,
+    extra: Vec<String>,
+    key: String,
+    run_id: String,
+) -> Result<StudyRunStart, AppError> {
+    let mut cmd = build_command(&cfg, &real_path, &extra)?;
+    let mut child = cmd
+        .spawn()
+        .map_err(|e| app_error("spawnFailed", format!("无法启动整理进程：{e}")))?;
+    let stdout = child
+        .stdout
+        .take()
+        .ok_or_else(|| app_error("spawnFailed", "拿不到子进程 stdout"))?;
+    let stderr = child
+        .stderr
+        .take()
+        .ok_or_else(|| app_error("spawnFailed", "拿不到子进程 stderr"))?;
+
+    let cancel = Arc::new(AtomicBool::new(false));
+    let child_slot = Arc::new(Mutex::new(Some(child)));
+    registry().lock().unwrap().insert(
+        key.clone(),
+        RunHandle {
+            run_id: run_id.clone(),
+            cancel: cancel.clone(),
+        },
+    );
+
+    let timeout_s = cfg.study_timeout_s.max(MIN_TIMEOUT_S);
+
+    // stdout：逐行转发（每行是 tidy.py 的一条 JSONL）
+    let out_app = app.clone();
+    let reader = thread::spawn(move || {
+        for line in BufReader::new(stdout).lines().map_while(Result::ok) {
+            let _ = out_app.emit(EVENT_NAME, line);
+        }
+    });
+
+    // stderr：必须排空，否则管道填满会把子进程顶死；只留尾部用于报错
+    let err_tail = Arc::new(Mutex::new(String::new()));
+    let err_slot = err_tail.clone();
+    let err_reader = thread::spawn(move || {
+        let mut buf = String::new();
+        if BufReader::new(stderr).read_to_string(&mut buf).is_err() {
+            return;
+        }
+        let trimmed: String = buf
+            .chars()
+            .rev()
+            .take(STDERR_TAIL_LIMIT)
+            .collect::<Vec<_>>()
+            .into_iter()
+            .rev()
+            .collect();
+        *err_slot.lock().unwrap() = trimmed;
+    });
+
+    // 监督线程：负责超时/取消 kill、wait 回收、注销互斥、发 exit 事件
+    thread::spawn(move || {
+        let deadline = Instant::now() + Duration::from_secs(timeout_s);
+        let mut timed_out = false;
+        let mut cancelled = false;
+        let status = loop {
+            let mut guard = child_slot.lock().unwrap();
+            match guard.as_mut() {
+                Some(proc) => match proc.try_wait() {
+                    Ok(Some(status)) => break Some(status),
+                    Ok(None) => {}
+                    Err(_) => break None,
+                },
+                None => break None,
+            }
+            if cancel.load(Ordering::SeqCst) {
+                cancelled = true;
+                if let Some(proc) = guard.as_mut() {
+                    let _ = proc.kill();
+                }
+                break None;
+            }
+            if Instant::now() >= deadline {
+                timed_out = true;
+                if let Some(proc) = guard.as_mut() {
+                    let _ = proc.kill();
+                }
+                break None;
+            }
+            drop(guard);
+            thread::sleep(POLL_INTERVAL);
+        };
+        // kill 之后必须 wait 回收，否则留下僵尸进程
+        {
+            let mut guard = child_slot.lock().unwrap();
+            if let Some(proc) = guard.as_mut() {
+                let _ = proc.wait();
+            }
+        }
+        let _ = reader.join();
+        let _ = err_reader.join();
+        registry().lock().unwrap().remove(&key);
+
+        let code = status.and_then(|s| s.code());
+        let ok = !timed_out && !cancelled && code == Some(0);
+        let detail = err_tail.lock().unwrap().clone();
+        let payload = serde_json::json!({
+            "type": "exit",
+            "ok": ok,
+            "code": code,
+            "timedOut": timed_out,
+            "cancelled": cancelled,
+            "stderr": if ok || detail.is_empty() { serde_json::Value::Null }
+                      else { serde_json::Value::String(detail) },
+        });
+        let _ = app.emit(EVENT_NAME, payload.to_string());
+    });
+
+    Ok(StudyRunStart { run_id, reused: false })
+}
+
+/// 设置页的连通性体检：python 在不在、脚本在不在、版本多少。
+///
+/// 失败不返回 Err —— 设置页要的是「人话原因」，不是错误弹窗。
+#[tauri::command]
+pub fn study_ping() -> Result<StudyPing, AppError> {
+    let cfg = default_store()?.load_config()?;
+    let script = tidy_script(&cfg.study_root);
+    let script_exists = script.is_file();
+    let mut ping = StudyPing {
+        ok: false,
+        python_version: None,
+        python: cfg.study_python.clone(),
+        study_root: cfg.study_root.clone(),
+        script: script.to_string_lossy().to_string(),
+        script_exists,
+        error: None,
+    };
+    if !Path::new(&cfg.study_python).is_file() {
+        ping.error = Some(format!("找不到 Python：{}", cfg.study_python));
+        return Ok(ping);
+    }
+    if !script_exists {
+        ping.error = Some(format!("找不到整理脚本：{}", script.display()));
+        return Ok(ping);
+    }
+    let mut cmd = Command::new(&cfg.study_python);
+    cmd.arg("-c").arg("import sys;print(sys.version)");
+    cmd.stdout(Stdio::piped()).stderr(Stdio::piped());
+    #[cfg(windows)]
+    {
+        use std::os::windows::process::CommandExt;
+        cmd.creation_flags(CREATE_NO_WINDOW);
+    }
+    let mut child = match cmd.spawn() {
+        Ok(child) => child,
+        Err(e) => {
+            ping.error = Some(format!("无法启动 Python：{e}"));
+            return Ok(ping);
+        }
+    };
+    let deadline = Instant::now() + PING_TIMEOUT;
+    loop {
+        match child.try_wait() {
+            Ok(Some(status)) => {
+                let mut out = String::new();
+                if let Some(mut stdout) = child.stdout.take() {
+                    let _ = stdout.read_to_string(&mut out);
+                }
+                if status.success() {
+                    ping.ok = true;
+                    ping.python_version = Some(out.trim().to_string());
+                } else {
+                    ping.error = Some(format!("Python 退出码 {:?}", status.code()));
+                }
+                break;
+            }
+            Ok(None) => {}
+            Err(e) => {
+                ping.error = Some(format!("等待 Python 失败：{e}"));
+                break;
+            }
+        }
+        if Instant::now() >= deadline {
+            let _ = child.kill();
+            let _ = child.wait();
+            ping.error = Some("检测 Python 超时".to_string());
+            break;
+        }
+        thread::sleep(POLL_INTERVAL);
+    }
+    Ok(ping)
+}
+
+/// 起一次整理。`apply=false` 即预览（不写笔记、不动掌握度）。
+#[tauri::command]
+pub fn study_tidy_start(
+    app: AppHandle,
+    note_path: String,
+    apply: bool,
+) -> Result<StudyRunStart, AppError> {
+    let cfg = default_store()?.load_config()?;
+    if !cfg.study_enabled {
+        return Err(app_error(
+            "studyDisabled",
+            "学习助手未启用：设置 → 学习助手 打开开关",
+        ));
+    }
+    let real = resolve_note_path(&note_path)?;
+    let key = real.to_string_lossy().to_string();
+
+    // 同一篇笔记只允许一个 run：重复点按钮直接复用，防狂点烧钱
+    if let Some(existing) = registry().lock().unwrap().get(&key) {
+        return Ok(StudyRunStart {
+            run_id: existing.run_id.clone(),
+            reused: true,
+        });
+    }
+
+    let mut extra: Vec<String> = Vec::new();
+    if apply {
+        extra.push("--apply".to_string());
+    }
+    let run_id = uuid::Uuid::new_v4().to_string();
+    spawn_run(app, cfg, real, extra, key, run_id)
+}
+
+/// 取消一次整理（杀掉子进程；监督线程负责回收）。
+#[tauri::command]
+pub fn study_tidy_cancel(run_id: String) -> Result<bool, AppError> {
+    let guard = registry().lock().unwrap();
+    for handle in guard.values() {
+        if handle.run_id == run_id {
+            handle.cancel.store(true, Ordering::SeqCst);
+            return Ok(true);
+        }
+    }
+    Ok(false)
+}
+
+/// 撤销：把 AI 整理区回滚到指定版本（用户区一字不动）。
+#[tauri::command]
+pub fn study_tidy_rollback(
+    app: AppHandle,
+    note_path: String,
+    version: String,
+) -> Result<StudyRunStart, AppError> {
+    let cfg = default_store()?.load_config()?;
+    if !cfg.study_enabled {
+        return Err(app_error(
+            "studyDisabled",
+            "学习助手未启用：设置 → 学习助手 打开开关",
+        ));
+    }
+    let real = resolve_note_path(&note_path)?;
+    let key = real.to_string_lossy().to_string();
+    if let Some(existing) = registry().lock().unwrap().get(&key) {
+        return Ok(StudyRunStart {
+            run_id: existing.run_id.clone(),
+            reused: true,
+        });
+    }
+    let extra = vec!["--apply".to_string(), "--rollback".to_string(), version];
+    let run_id = uuid::Uuid::new_v4().to_string();
+    spawn_run(app, cfg, real, extra, key, run_id)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::fs;
+
+    fn temp_root(tag: &str) -> PathBuf {
+        let dir = std::env::temp_dir().join(format!("floral-study-{tag}-{}", uuid::Uuid::new_v4()));
+        fs::create_dir_all(dir.join("notes").join("Python")).unwrap();
+        dir
+    }
+
+    #[test]
+    fn tidy_script_sits_under_study_root() {
+        let path = tidy_script(r"E:\Docs\Code\Java\book");
+        assert!(path.ends_with(Path::new("study").join("tools").join("tidy.py")));
+    }
+
+    #[test]
+    fn accepts_markdown_inside_notes_dir() {
+        let root = temp_root("inside");
+        let note = root.join("notes").join("Python").join("a.md");
+        fs::write(&note, "# hi").unwrap();
+        let notes_root = root.join("notes").canonicalize().unwrap();
+        let real = note.canonicalize().unwrap();
+        assert_eq!(validate_within(&notes_root, &real).unwrap(), real);
+    }
+
+    #[test]
+    fn rejects_path_outside_notes_dir() {
+        let root = temp_root("outside");
+        let outside = root.join("config.json");
+        fs::write(&outside, "{}").unwrap();
+        let notes_root = root.join("notes").canonicalize().unwrap();
+        let real = outside.canonicalize().unwrap();
+        let error = validate_within(&notes_root, &real).unwrap_err();
+        assert_eq!(error.code, "unsafePath");
+    }
+
+    #[test]
+    fn rejects_traversal_out_of_notes_dir() {
+        // notes/../secret.md 由 canonicalize 折叠成 <root>/secret.md → 必须被拒
+        let root = temp_root("traversal");
+        let secret = root.join("secret.md");
+        fs::write(&secret, "top secret").unwrap();
+        let notes_root = root.join("notes").canonicalize().unwrap();
+        let sneaky = root
+            .join("notes")
+            .join("..")
+            .join("secret.md")
+            .canonicalize()
+            .unwrap();
+        assert!(!sneaky.starts_with(&notes_root), "前提：穿越后已在目录外");
+        let error = validate_within(&notes_root, &sneaky).unwrap_err();
+        assert_eq!(error.code, "unsafePath");
+    }
+
+    #[test]
+    fn rejects_non_markdown_inside_notes_dir() {
+        let root = temp_root("nonmd");
+        let other = root.join("notes").join("Python").join("data.json");
+        fs::write(&other, "{}").unwrap();
+        let notes_root = root.join("notes").canonicalize().unwrap();
+        let real = other.canonicalize().unwrap();
+        let error = validate_within(&notes_root, &real).unwrap_err();
+        assert_eq!(error.code, "notMarkdown");
+    }
+
+    #[test]
+    fn accepts_uppercase_md_extension() {
+        let root = temp_root("upper");
+        let note = root.join("notes").join("Python").join("A.MD");
+        fs::write(&note, "# hi").unwrap();
+        let notes_root = root.join("notes").canonicalize().unwrap();
+        let real = note.canonicalize().unwrap();
+        assert!(validate_within(&notes_root, &real).is_ok());
+    }
+
+    #[test]
+    fn registry_starts_empty_and_is_shared() {
+        assert!(registry().lock().unwrap().is_empty());
+    }
+}
