@@ -0,0 +1,206 @@
+import { describe, expect, test } from "vitest";
+import type { NoteMetadata } from "./types";
+import {
+  DEFAULT_WALL_COLUMNS,
+  MAX_WALL_COLUMNS,
+  MIN_CARD_WIDTH,
+  WALL_TILT_DEGREES,
+  buildWallCards,
+  groupWallSections,
+  stableHash,
+  tiltFor,
+  toWallCard,
+  wallColumnsFor,
+  wallSummary,
+} from "./noteWall";
+
+function note(overrides: Partial<NoteMetadata> & { id: string }): NoteMetadata {
+  return {
+    title: "",
+    fileName: `${overrides.id}.md`,
+    category: "",
+    createdAt: "2026-01-01T00:00:00Z",
+    updatedAt: "2026-01-01T00:00:00Z",
+    wordCount: 0,
+    preview: "",
+    ...overrides,
+  };
+}
+
+describe("stableHash / tiltFor", () => {
+  test("hash is deterministic for the same input", () => {
+    expect(stableHash("note-1")).toBe(stableHash("note-1"));
+  });
+
+  test("hash differs for different inputs", () => {
+    expect(stableHash("note-1")).not.toBe(stableHash("note-2"));
+  });
+
+  test("tilt stays within the configured range", () => {
+    for (let i = 0; i < 200; i++) {
+      const angle = tiltFor(`note-${i}`);
+      expect(angle).toBeGreaterThanOrEqual(-WALL_TILT_DEGREES);
+      expect(angle).toBeLessThanOrEqual(WALL_TILT_DEGREES);
+    }
+  });
+
+  test("tilt is stable across repeated calls (no random jitter on re-render)", () => {
+    expect(tiltFor("abc")).toBe(tiltFor("abc"));
+  });
+
+  test("tilt is rounded to two decimals", () => {
+    const angle = tiltFor("some-note-id");
+    expect(Number.isInteger(angle * 100)).toBe(true);
+  });
+
+  test("empty id or non-positive max yields zero tilt", () => {
+    expect(tiltFor("")).toBe(0);
+    expect(tiltFor("abc", 0)).toBe(0);
+    expect(tiltFor("abc", -1)).toBe(0);
+  });
+
+  test("respects a custom max", () => {
+    for (let i = 0; i < 50; i++) {
+      const angle = tiltFor(`n-${i}`, 0.5);
+      expect(Math.abs(angle)).toBeLessThanOrEqual(0.5);
+    }
+  });
+});
+
+describe("wallColumnsFor", () => {
+  test("fits as many columns as the width allows", () => {
+    expect(wallColumnsFor(MIN_CARD_WIDTH * 3)).toBe(3);
+    expect(wallColumnsFor(MIN_CARD_WIDTH * 2 + 50)).toBe(2);
+  });
+
+  test("never goes below one column", () => {
+    expect(wallColumnsFor(10)).toBe(1);
+    expect(wallColumnsFor(0)).toBe(DEFAULT_WALL_COLUMNS);
+  });
+
+  test("caps at the maximum column count", () => {
+    expect(wallColumnsFor(100_000)).toBe(MAX_WALL_COLUMNS);
+  });
+
+  test("falls back to the default for invalid widths", () => {
+    expect(wallColumnsFor(Number.NaN)).toBe(DEFAULT_WALL_COLUMNS);
+    expect(wallColumnsFor(-5)).toBe(DEFAULT_WALL_COLUMNS);
+  });
+
+  test("honours a custom minimum card width", () => {
+    expect(wallColumnsFor(600, 300)).toBe(2);
+  });
+});
+
+describe("toWallCard", () => {
+  test("carries display fields and derives tilt from the id", () => {
+    const card = toWallCard(note({ id: "n1", title: "标题", preview: "预览", wordCount: 12 }), {
+      color: "#ffeeaa",
+      pinned: true,
+    });
+    expect(card).toMatchObject({
+      id: "n1",
+      title: "标题",
+      preview: "预览",
+      wordCount: 12,
+      color: "#ffeeaa",
+      pinned: true,
+    });
+    expect(card.tilt).toBe(tiltFor("n1"));
+  });
+});
+
+describe("buildWallCards", () => {
+  const notes = [
+    note({ id: "a", updatedAt: "2026-01-01T00:00:00Z", category: "工作" }),
+    note({ id: "b", updatedAt: "2026-03-01T00:00:00Z", category: "工作" }),
+    note({ id: "c", updatedAt: "2026-02-01T00:00:00Z", category: "" }),
+  ];
+
+  test("sorts by updatedAt descending by default", () => {
+    expect(buildWallCards(notes).map((c) => c.id)).toEqual(["b", "c", "a"]);
+  });
+
+  test("pinned cards come first, then the rest keep recency order", () => {
+    const cards = buildWallCards(notes, { pinnedIds: new Set(["a"]) });
+    expect(cards.map((c) => c.id)).toEqual(["a", "b", "c"]);
+  });
+
+  test("filters by category, with empty string meaning uncategorised", () => {
+    expect(buildWallCards(notes, { category: "工作" }).map((c) => c.id)).toEqual(["b", "a"]);
+    expect(buildWallCards(notes, { category: "" }).map((c) => c.id)).toEqual(["c"]);
+  });
+
+  test("undefined category shows every note", () => {
+    expect(buildWallCards(notes, {})).toHaveLength(3);
+  });
+
+  test("applies the limit after sorting", () => {
+    expect(buildWallCards(notes, { limit: 2 }).map((c) => c.id)).toEqual(["b", "c"]);
+    expect(buildWallCards(notes, { limit: 0 })).toEqual([]);
+  });
+
+  test("is stable when updatedAt ties (falls back to id)", () => {
+    const tied = [
+      note({ id: "z", updatedAt: "2026-01-01T00:00:00Z" }),
+      note({ id: "y", updatedAt: "2026-01-01T00:00:00Z" }),
+    ];
+    expect(buildWallCards(tied).map((c) => c.id)).toEqual(["y", "z"]);
+  });
+
+  test("does not mutate the input array", () => {
+    const input = [note({ id: "a" }), note({ id: "b", updatedAt: "2026-05-01T00:00:00Z" })];
+    const snapshot = input.map((n) => n.id);
+    buildWallCards(input);
+    expect(input.map((n) => n.id)).toEqual(snapshot);
+  });
+
+  test("applies the configured colour to every card", () => {
+    expect(buildWallCards(notes, { color: "#123456" }).every((c) => c.color === "#123456")).toBe(
+      true,
+    );
+  });
+});
+
+describe("groupWallSections", () => {
+  test("groups cards by category and sorts uncategorised last", () => {
+    const cards = buildWallCards([
+      note({ id: "a", category: "工作" }),
+      note({ id: "b", category: "" }),
+      note({ id: "c", category: "学习" }),
+    ]);
+    expect(groupWallSections(cards).map((s) => s.category)).toEqual(["学习", "工作", ""]);
+  });
+
+  test("keeps every card exactly once", () => {
+    const cards = buildWallCards([
+      note({ id: "a", category: "X" }),
+      note({ id: "b", category: "X" }),
+      note({ id: "c", category: "Y" }),
+    ]);
+    const total = groupWallSections(cards).reduce((sum, s) => sum + s.cards.length, 0);
+    expect(total).toBe(3);
+  });
+
+  test("returns an empty list for no cards", () => {
+    expect(groupWallSections([])).toEqual([]);
+  });
+});
+
+describe("wallSummary", () => {
+  test("counts total, pinned, categories and words", () => {
+    const cards = buildWallCards(
+      [
+        note({ id: "a", category: "工作", wordCount: 100 }),
+        note({ id: "b", category: "工作", wordCount: 50 }),
+        note({ id: "c", category: "学习", wordCount: 25 }),
+      ],
+      { pinnedIds: new Set(["a"]) },
+    );
+    expect(wallSummary(cards)).toEqual({ total: 3, pinned: 1, categories: 2, words: 175 });
+  });
+
+  test("handles an empty wall", () => {
+    expect(wallSummary([])).toEqual({ total: 0, pinned: 0, categories: 0, words: 0 });
+  });
+});
diff --git a/src/features/notes/noteWall.ts b/src/features/notes/noteWall.ts
new file mode 100644
index 0000000..c44c6c4
--- /dev/null
+++ b/src/features/notes/noteWall.ts
@@ -0,0 +1,166 @@
+import type { NoteMetadata } from "./types";
+
+/**
+ * 便签墙（Note Wall）的纯逻辑。
+ *
+ * 刻意与组件分离：仓库的测试是纯逻辑风格（没有 jsdom / testing-library），
+ * 所以「墙上该显示哪些便签、怎么排序、倾斜多少、分几列」这些决策全部放在这里，
+ * 可以确定性测试；组件只负责把结果画出来。
+ */
+
+export const DEFAULT_WALL_COLUMNS = 3;
+export const MAX_WALL_COLUMNS = 6;
+export const MIN_CARD_WIDTH = 200;
+export const WALL_TILT_DEGREES = 1.4;
+
+export interface WallCard {
+  id: string;
+  title: string;
+  preview: string;
+  category: string;
+  /** 便签底色（来自设置里的 tileColor） */
+  color: string;
+  /** 轻微倾斜角（度），让墙面看起来像真的贴上去的 */
+  tilt: number;
+  pinned: boolean;
+  updatedAt: string;
+  wordCount: number;
+}
+
+export interface BuildWallCardsOptions {
+  /** 只看这个分类；空串表示「未分类」，undefined 表示不过滤 */
+  category?: string;
+  color?: string;
+  pinnedIds?: ReadonlySet<string>;
+  /** 置顶的排在最前，其余按 updatedAt 降序 */
+  limit?: number;
+}
+
+/**
+ * 稳定哈希（FNV-1a 32 位）。
+ * 用它而不是 Math.random()，是为了让同一张便签每次渲染的倾斜角都一样——
+ * 否则每次重渲染整面墙都在抖，而且测试无法复现。
+ */
+export function stableHash(input: string): number {
+  let hash = 0x811c9dc5;
+  for (let i = 0; i < input.length; i++) {
+    hash ^= input.charCodeAt(i);
+    hash = Math.imul(hash, 0x01000193) >>> 0;
+  }
+  return hash >>> 0;
+}
+
+/** 由 id 推导倾斜角，落在 [-max, max] 区间内。 */
+export function tiltFor(id: string, max: number = WALL_TILT_DEGREES): number {
+  if (!id || max <= 0) return 0;
+  const unit = stableHash(id) / 0xffffffff; // [0, 1]
+  const angle = (unit * 2 - 1) * max; // [-max, max]
+  // 保留两位小数，避免浮点噪声让快照不稳定
+  return Math.round(angle * 100) / 100;
+}
+
+/**
+ * 按宽度决定列数：先按最小卡片宽度塞，再夹到 [1, MAX_WALL_COLUMNS]。
+ * 这样窄窗口不会出现挤成一团的便签。
+ */
+export function wallColumnsFor(width: number, minCardWidth: number = MIN_CARD_WIDTH): number {
+  if (!Number.isFinite(width) || width <= 0) return DEFAULT_WALL_COLUMNS;
+  const fitted = Math.floor(width / Math.max(minCardWidth, 1));
+  return Math.min(Math.max(fitted, 1), MAX_WALL_COLUMNS);
+}
+
+/** 便签墙上的一张卡：把 NoteMetadata 转成渲染所需的最小数据。 */
+export function toWallCard(
+  note: NoteMetadata,
+  options: { color: string; pinned: boolean },
+): WallCard {
+  return {
+    id: note.id,
+    title: note.title,
+    preview: note.preview,
+    category: note.category,
+    color: options.color,
+    tilt: tiltFor(note.id),
+    pinned: options.pinned,
+    updatedAt: note.updatedAt,
+    wordCount: note.wordCount,
+  };
+}
+
+/**
+ * 组装墙上的卡片列表。
+ *
+ * 排序规则：置顶优先 → updatedAt 降序（时间相同则按 id 稳定排序）。
+ * 排序必须完全确定，否则测试和快照都会飘。
+ */
+export function buildWallCards(
+  notes: readonly NoteMetadata[],
+  options: BuildWallCardsOptions = {},
+): WallCard[] {
+  const { category, color = "#f6f3ec", pinnedIds, limit } = options;
+  const pinned = pinnedIds ?? new Set<string>();
+
+  const filtered = notes.filter((note) =>
+    category === undefined ? true : note.category === category,
+  );
+
+  const cards = filtered.map((note) =>
+    toWallCard(note, { color, pinned: pinned.has(note.id) }),
+  );
+
+  cards.sort((a, b) => {
+    if (a.pinned !== b.pinned) return a.pinned ? -1 : 1;
+    if (a.updatedAt !== b.updatedAt) return a.updatedAt < b.updatedAt ? 1 : -1;
+    return a.id < b.id ? -1 : a.id > b.id ? 1 : 0;
+  });
+
+  return typeof limit === "number" && limit >= 0 ? cards.slice(0, limit) : cards;
+}
+
+export interface WallSection {
+  category: string;
+  cards: WallCard[];
+}
+
+/**
+ * 按分类分组（用于「全部」视图下给墙面分块）。
+ * 空分类归到 `""`，调用方自行决定怎么显示它的标题。
+ */
+export function groupWallSections(cards: readonly WallCard[]): WallSection[] {
+  const buckets = new Map<string, WallCard[]>();
+  for (const card of cards) {
+    const list = buckets.get(card.category);
+    if (list) {
+      list.push(card);
+    } else {
+      buckets.set(card.category, [card]);
+    }
+  }
+  return [...buckets.entries()]
+    .map(([category, list]) => ({ category, cards: list }))
+    .sort((a, b) => {
+      // 未分类（""）排在最后，其余按名称
+      if (a.category === b.category) return 0;
+      if (a.category === "") return 1;
+      if (b.category === "") return -1;
+      return a.category < b.category ? -1 : 1;
+    });
+}
+
+/** 墙面统计，用于标题栏一行摘要。 */
+export function wallSummary(cards: readonly WallCard[]): {
+  total: number;
+  pinned: number;
+  categories: number;
+  words: number;
+} {
+  const categories = new Set<string>();
+  let pinned = 0;
+  let words = 0;
+  for (const card of cards) {
+    categories.add(card.category);
+    if (card.pinned) pinned++;
+    words += card.wordCount;
+  }
+  return { total: cards.length, pinned, categories: categories.size, words };
+}
