+              {t("wall.title", { defaultValue: "便签墙" })}
+            </span>
+            <button
+              onClick={() => setWallOpen(false)}
+              className="text-[12px] px-3 py-1 rounded border border-paper-deep/40 text-ink-soft hover:bg-bamboo-mist/60 hover:text-bamboo transition-colors cursor-pointer"
+            >
+              {t("common.close", { defaultValue: "关闭" })}
+            </button>
+          </div>
+          <div className="flex-1 min-h-0">
+            <NoteWall
+              notes={filteredNotes}
+              pinnedIds={pinnedTileIds}
+              tileColor={settingsConfig?.tileColor}
+              fontSize={settingsConfig?.surfaceFontSize ?? 14}
+              renderMarkdown={settingsConfig?.tileRenderMarkdown ?? false}
+              onOpenNote={(id) => {
+                setSelectedId(id);
+                setWallOpen(false);
+              }}
+            />
+          </div>
+        </div>
+      )}
     </div>
   );
 }
diff --git a/src/components/NoteWall.tsx b/src/components/NoteWall.tsx
new file mode 100644
index 0000000..ca7f754
--- /dev/null
+++ b/src/components/NoteWall.tsx
@@ -0,0 +1,251 @@
+import type { CSSProperties, MouseEvent } from "react";
+import { useEffect, useMemo, useRef, useState } from "react";
+import { useTranslation } from "react-i18next";
+import { Tile } from "./Tile";
+import type { NoteMetadata } from "../features/notes/types";
+import { getDisplayTitle } from "../features/notes/noteUtils";
+import {
+  DEFAULT_WALL_COLUMNS,
+  buildWallCards,
+  groupWallSections,
+  wallColumnsFor,
+  wallSummary,
+  type WallCard,
+} from "../features/notes/noteWall";
+
+export interface NoteWallProps {
+  notes: readonly NoteMetadata[];
+  /** undefined = 全部；"" = 未分类；其它 = 该分类 */
+  activeCategory?: string;
+  pinnedIds?: ReadonlySet<string>;
+  tileColor?: string;
+  fontSize?: number;
+  renderMarkdown?: boolean;
+  imageBaseDir?: string;
+  /** 置顶的便签是否高亮描边 */
+  highlightPinned?: boolean;
+  className?: string;
+  onOpenNote: (id: string) => void;
+  onTogglePin?: (id: string) => void;
+  onNoteContextMenu?: (id: string, event: MouseEvent<HTMLDivElement>) => void;
+}
+
+/** 用容器宽度算列数；ResizeObserver 缺失时退回默认列数。 */
+function useWallColumns(ref: React.RefObject<HTMLElement | null>): number {
+  const [columns, setColumns] = useState(DEFAULT_WALL_COLUMNS);
+
+  useEffect(() => {
+    const element = ref.current;
+    if (!element) return;
+
+    const apply = (width: number) => setColumns(wallColumnsFor(width));
+
+    if (typeof ResizeObserver === "undefined") {
+      apply(element.clientWidth);
+      return;
+    }
+
+    const observer = new ResizeObserver((entries) => {
+      for (const entry of entries) {
+        apply(entry.contentRect.width);
+      }
+    });
+    observer.observe(element);
+    apply(element.clientWidth);
+    return () => observer.disconnect();
+  }, [ref]);
+
+  return columns;
+}
+
+function WallNoteCard({
+  card,
+  fontSize,
+  renderMarkdown,
+  imageBaseDir,
+  highlightPinned,
+  onOpenNote,
+  onTogglePin,
+  onNoteContextMenu,
+}: {
+  card: WallCard;
+  fontSize: number;
+  renderMarkdown: boolean;
+  imageBaseDir?: string;
+  highlightPinned: boolean;
+  onOpenNote: (id: string) => void;
+  onTogglePin?: (id: string) => void;
+  onNoteContextMenu?: (id: string, event: MouseEvent<HTMLDivElement>) => void;
+}) {
+  const { t } = useTranslation();
+  const title = getDisplayTitle({ title: card.title, preview: card.preview }, t);
+
+  const wrapStyle: CSSProperties = {
+    breakInside: "avoid",
+    marginBottom: "18px",
+    // 轻微倾斜：由 id 稳定推导，重渲染不会抖
+    transform: card.tilt ? `rotate(${card.tilt}deg)` : undefined,
+    transition: "transform 0.18s ease",
+  };
+
+  return (
+    <div style={wrapStyle} className="break-inside-avoid">
+      <div className="relative">
+        <Tile
+          title={title}
+          content={card.preview}
+          color={card.color}
+          fontSize={fontSize}
+          renderMarkdown={renderMarkdown}
+          imageBaseDir={imageBaseDir}
+          role="button"
+          tabIndex={0}
+          aria-label={title}
+          onClick={() => onOpenNote(card.id)}
+          onContextMenu={(event) => onNoteContextMenu?.(card.id, event)}
+          onKeyDown={(event) => {
+            if (event.key === "Enter" || event.key === " ") {
+              event.preventDefault();
+              onOpenNote(card.id);
+            }
+          }}
+          className={[
+            "cursor-pointer",
+            highlightPinned && card.pinned ? "ring-2 ring-amber-400/60" : "",
+          ]
+            .filter(Boolean)
+            .join(" ")}
+          style={{ width: "100%" }}
+        >
+          <div className="absolute top-2 right-2 flex items-center gap-1">
+            {card.pinned && (
+              <span
+                className="text-[10px] px-1.5 py-0.5 rounded-full bg-black/10"
+                title={t("wall.pinned", { defaultValue: "置顶" })}
+              >
+                📌
+              </span>
+            )}
+            {onTogglePin && (
+              <button
+                type="button"
+                className="text-[10px] px-1.5 py-0.5 rounded-full bg-black/10 opacity-0 hover:opacity-100 focus:opacity-100 transition-opacity"
+                onClick={(event) => {
+                  event.stopPropagation();
+                  onTogglePin(card.id);
+                }}
+                title={t("wall.pinned", { defaultValue: "置顶" })}
+              >
+                {card.pinned ? "取消" : "置顶"}
+              </button>
+            )}
+          </div>
+        </Tile>
+      </div>
+    </div>
+  );
+}
+
+/**
+ * 便签墙：把所有便签按卡片铺开成一面墙。
+ *
+ * - 与「贴到桌面」的浮窗（tile window）互补：那个是把单张便签钉在屏幕上，
+ *   这个是把整库便签一次性摊开看全貌。
+ * - 布局用 CSS 多列（masonry 效果），列数随容器宽度自适应。
+ * - 全部布局决策都在 `features/notes/noteWall.ts` 里，组件只负责画。
+ */
+export function NoteWall({
+  notes,
+  activeCategory,
+  pinnedIds,
+  tileColor = "#f6f3ec",
+  fontSize = 14,
+  renderMarkdown = false,
+  imageBaseDir,
+  highlightPinned = true,
+  className = "",
+  onOpenNote,
+  onTogglePin,
+  onNoteContextMenu,
+}: NoteWallProps) {
+  const { t } = useTranslation();
+  const containerRef = useRef<HTMLDivElement | null>(null);
+  const columns = useWallColumns(containerRef);
+
+  const cards = useMemo(
+    () => buildWallCards(notes, { category: activeCategory, color: tileColor, pinnedIds }),
+    [notes, activeCategory, tileColor, pinnedIds],
+  );
+
+  const summary = useMemo(() => wallSummary(cards), [cards]);
+  // 选中某个分类时不再分块；「全部」视图下按分类分块
+  const sections = useMemo(
+    () => (activeCategory === undefined ? groupWallSections(cards) : [{ category: "", cards }]),
+    [activeCategory, cards],
+  );
+
+  const columnStyle: CSSProperties = {
+    columnCount: columns,
+    columnGap: "18px",
+  };
+
+  return (
+    <div
+      className={`flex flex-col h-full min-h-0 ${className}`}
+      data-note-wall="true"
+      data-wall-columns={columns}
+    >
+      <div className="flex items-baseline justify-between gap-3 px-4 py-2 shrink-0">
+        <div className="font-display tracking-wide text-sm opacity-80">
+          {t("wall.title", { defaultValue: "便签墙" })}
+        </div>
+        <div className="text-xs opacity-50" data-wall-summary="true">
+          {t("wall.summary", {
+            defaultValue: "共 {{total}} 张便签 · {{pinned}} 张置顶 · {{categories}} 个分类",
+            total: summary.total,
+            pinned: summary.pinned,
+            categories: summary.categories,
+          })}
+        </div>
+      </div>
+
+      <div ref={containerRef} className="flex-1 min-h-0 overflow-y-auto px-4 pb-6 scrollbar-hidden">
+        {cards.length === 0 ? (
+          <div
+            className="h-full flex items-center justify-center text-sm opacity-45"
+            data-wall-empty="true"
+          >
+            {t("wall.empty", { defaultValue: "这面墙还是空的，先去写一张便签吧" })}
+          </div>
+        ) : (
+          sections.map((section) => (
+            <section key={section.category || "__uncategorised__"} data-wall-section={section.category}>
+              {activeCategory === undefined && (
+                <div className="text-xs opacity-45 mb-2 mt-1">
+                  {section.category === ""
+                    ? t("wall.uncategorised", { defaultValue: "未分类" })
+                    : section.category}
+                </div>
+              )}
+              <div style={columnStyle}>
+                {section.cards.map((card) => (
+                  <WallNoteCard
+                    key={card.id}
+                    card={card}
+                    fontSize={fontSize}
+                    renderMarkdown={renderMarkdown}
+                    imageBaseDir={imageBaseDir}
+                    highlightPinned={highlightPinned}
+                    onOpenNote={onOpenNote}
+                    onTogglePin={onTogglePin}
+                    onNoteContextMenu={onNoteContextMenu}
+                  />
+                ))}
+              </div>
+            </section>
+          ))
+        )}
+      </div>
+    </div>
+  );
+}
