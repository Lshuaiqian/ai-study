+/// 归一化分类路径：允许 `工作/2026` 这样的多层写法，
+/// 但拒绝空段、`.`、`..` 以及 Windows 非法字符，防止写出 notes_dir 之外。
+///
+/// 这是「多层文件夹」补丁新增的函数，取代原先各处「一律拒绝 /」的内联校验。
+pub(crate) fn normalize_category(name: &str) -> Result<String, AppError> {
+    let name = name.trim().replace('\\', "/");
+    let name = name.trim_matches('/');
+    if name.is_empty() {
+        return Err(AppError::category_name_empty());
+    }
+    let mut parts: Vec<&str> = Vec::new();
+    for part in name.split('/') {
+        let part = part.trim();
+        if part.is_empty() || part == "." || part == ".." {
+            return Err(AppError::category_name_invalid_chars());
+        }
+        if part.contains([':', '*', '?', '"', '<', '>', '|']) {
+            return Err(AppError::category_name_invalid_chars());
+        }
+        parts.push(part);
+    }
+    Ok(parts.join("/"))
+}
+
+/// 递归收集分类目录，输出用 `/` 分隔的相对路径（如 `工作/2026`）。
+///
+/// 「多层文件夹」补丁新增。改前 `list_categories` 只遍历 notes_dir 的一层。
+fn collect_categories(dir: &Path, prefix: &str, out: &mut Vec<String>) -> Result<(), AppError> {
+    for entry in fs::read_dir(dir)? {
+        let entry = entry?;
+        if !entry.path().is_dir() {
+            continue;
+        }
+        let name = entry.file_name().to_string_lossy().to_string();
+        if name.starts_with('.') {
+            continue;
+        }
+        let current = if prefix.is_empty() {
+            name
+        } else {
+            format!("{prefix}/{name}")
+        };
+        out.push(current.clone());
+        collect_categories(&entry.path(), &current, out)?;
+    }
+    Ok(())
+}
+
+/// 归一化「可选」分类：空串表示未分类（笔记直接放在 notes_dir 根下），不算错误。
